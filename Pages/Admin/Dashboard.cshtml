@page
@model LicenseServer.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h3 class="fw-bold mb-4"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard</h3>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-4 text-center">
            <div class="fs-1 text-primary fw-bold">@Model.TotalCustomers</div>
            <div class="text-muted">Customers</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-4 text-center">
            <div class="fs-1 text-success fw-bold">@Model.ActiveLicenses</div>
            <div class="text-muted">Active Licenses</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-4 text-center">
            <div class="fs-1 text-warning fw-bold">@Model.ExpiringIn7Days</div>
            <div class="text-muted">Expiring Soon</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-4 text-center">
            <div class="fs-1 text-danger fw-bold">@Model.RevokedLicenses</div>
            <div class="text-muted">Revoked</div>
        </div>
    </div>
</div>

<div class="card p-4">
    <h5 class="fw-bold mb-3">Recent Licenses</h5>
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Key</th><th>Customer</th><th>Type</th><th>Status</th><th>Expires</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var l in Model.RecentLicenses)
        {
            <tr>
                <td><span class="key-box">@l.LicenseKey</span></td>
                <td>@l.Customer?.Name</td>
                <td><span class="badge bg-secondary">@l.Type</span></td>
                <td>
                    <span class="badge @(l.Status == LicenseStatus.Active ? "badge-active" :
                                         l.Status == LicenseStatus.Revoked ? "badge-revoked" :
                                         l.Status == LicenseStatus.Suspended ? "badge-suspended" : "badge-expired")">
                        @l.Status
                    </span>
                </td>
                <td>@l.ExpiresAt.ToString("dd MMM yyyy")</td>
                <td>
                    <a href="/Admin/LicenseDetail?id=@l.Id" class="btn btn-sm btn-outline-primary">Manage</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
