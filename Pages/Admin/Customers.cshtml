@page
@model LicenseServer.Pages.Admin.CustomersModel
@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Customers</h3>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="bi bi-plus-lg me-1"></i>Add Customer
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<div class="card p-4">
    <table class="table table-hover">
        <thead class="table-light">
            <tr><th>Name</th><th>Email</th><th>Phone</th><th>Licenses</th><th>Created</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var c in Model.Customers)
        {
            <tr>
                <td class="fw-semibold">@c.Name</td>
                <td>@c.Email</td>
                <td>@c.Phone</td>
                <td><span class="badge bg-primary">@c.Licenses.Count</span></td>
                <td>@c.CreatedAt.ToString("dd MMM yyyy")</td>
                <td>
                    <a href="/Admin/Licenses?customerId=@c.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-key"></i> Licenses
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<!-- Add Customer Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Add Customer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name *</label>
                        <input asp-for="Input.Name" class="form-control" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email *</label>
                        <input asp-for="Input.Email" class="form-control" type="email" required/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phone</label>
                        <input asp-for="Input.Phone" class="form-control"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>
