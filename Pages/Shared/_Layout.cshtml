<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] – Clinic License Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"/>
    <style>
        body { background: #f0f2f5; }
        .sidebar { width: 240px; min-height: 100vh; background: #1e293b; }
        .sidebar a { color: #94a3b8; text-decoration: none; display: block; padding: 10px 20px; border-radius: 8px; margin: 2px 10px; }
        .sidebar a:hover, .sidebar a.active { background: #2563eb; color: white; }
        .sidebar .brand { color: white; font-weight: 700; font-size: 1.1rem; padding: 20px; border-bottom: 1px solid #334155; margin-bottom: 10px; }
        .main-content { flex: 1; padding: 24px; }
        .card { border: none; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,.07); }
        .badge-active   { background: #dcfce7; color: #16a34a; }
        .badge-revoked  { background: #fee2e2; color: #dc2626; }
        .badge-suspended{ background: #fef9c3; color: #ca8a04; }
        .badge-expired  { background: #f3f4f6; color: #6b7280; }
        .key-box { font-family: monospace; font-size: 1.1rem; background: #f1f5f9; border-radius: 8px; padding: 8px 14px; letter-spacing: 2px; }
    </style>
</head>
<body>
<div class="d-flex">
    <div class="sidebar d-flex flex-column">
        <div class="brand"><i class="bi bi-shield-check me-2"></i>License Admin</div>
        <a href="/Admin/Dashboard" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Dashboard") == true ? "active" : "")">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>
        <a href="/Admin/Customers" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("Customer") == true ? "active" : "")">
            <i class="bi bi-people me-2"></i>Customers
        </a>
        <a href="/Admin/Licenses" class="@(ViewContext.RouteData.Values["page"]?.ToString()?.Contains("License") == true ? "active" : "")">
            <i class="bi bi-key me-2"></i>Licenses
        </a>
        <div class="mt-auto p-3">
            <form method="post" action="/Auth/Logout">
                <button type="submit" class="btn btn-outline-secondary w-100 text-white border-secondary">
                    <i class="bi bi-box-arrow-left me-2"></i>Logout
                </button>
            </form>
        </div>
    </div>
    <div class="main-content">
        @RenderBody()
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
