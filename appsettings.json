{
  "Firebase": {
    "ProjectId": "clinic-license",
    "ServiceAccountKeyPath": "keys/firebase-service-account.json"
  },
  "Licensing": {
    "PrivateKeyPath": "keys/private.pem"
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "POST:/api/activation/activate",  "Period": "1m", "Limit": 10 },
      { "Endpoint": "POST:/api/activation/heartbeat", "Period": "1m", "Limit": 30 },
      { "Endpoint": "*",                               "Period": "1s", "Limit": 20 }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5000;https://0.0.0.0:5001"
}
